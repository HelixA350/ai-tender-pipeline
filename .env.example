# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tenders
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tenders
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/tenders

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# OpenAI (custom endpoint)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=api.agentplatform.ru
OPENAI_MODEL=openai/gpt-5.2-chat

# Worker
WORKER_CONCURRENCY=4
